{
  "name": "tavern-card-studio",
  "private": true,
  "version": "0.1.0",
  "description": "本地桌面端 SillyTavern 角色卡工作站：转换、编辑、模板美化、AI 辅助生成、诊断修复、同人卡工坊",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "release": "tauri build && node scripts/collect-release.mjs",
    "e2e": "playwright test",
    "e2e:dev": "node scripts/e2e-dev.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@lezer/highlight": "^1.2.1",
    "@medv/finder": "^4.0.2",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^15.0.0",
    "codemirror": "^6.0.1",
    "js-tiktoken": "^1.0.21",
    "jszip": "^3.10.1",
    "naive-ui": "^2.43.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-i18n": "^10.0.7",
    "vue-router": "^4.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.0"
  }
}
